NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only. Never expose with a NEXT_PUBLIC_ prefix — this key bypasses
# Row Level Security entirely. Needed for the Manage Users page (inviting
# users and generating password-reset links via the Supabase Admin API).
# Get it from Supabase dashboard -> Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
